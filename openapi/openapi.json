    "/api/v1/bootstrap/prepare": {
      "post": {
        "operationId": "prepareBootstrap",
        "tags": [
          "bootstrap"
        ],
        "description": "Validates tenant/school/admin details plus the OIDC provider (live discovery), stores the encrypted draft, and starts the bootstrap OIDC flow. The operator credential travels in the Authorization header, never query or ambient cookies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tenantName",
                  "tenantSlug",
                  "schoolName",
                  "schoolSlug",
                  "schoolTimeZone",
                  "adminGivenName",
                  "adminFamilyName",
                  "adminDisplayName",
                  "providerKey",
                  "providerDisplayName",
                  "providerIssuer",
                  "providerClientId",
                  "providerClientSecret",
                  "providerAuthMethod",
                  "providerScopes"
                ],
                "properties": {
                  "tenantName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "tenantSlug": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "maxLength": 63
                  },
                  "schoolName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "schoolSlug": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "maxLength": 63
                  },
                  "schoolTimeZone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "adminGivenName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "adminFamilyName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "adminDisplayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "providerKey": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "maxLength": 63
                  },
                  "providerDisplayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "providerPreset": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "google"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "generic"
                        ]
                      }
                    ]
                  },
                  "providerIssuer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "providerClientId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "providerClientSecret": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "providerAuthMethod": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "client_secret_post"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "client_secret_basic"
                        ]
                      }
                    ]
                  },
                  "providerScopes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                },
                "additionalProperties": false
              }
            }
          }
